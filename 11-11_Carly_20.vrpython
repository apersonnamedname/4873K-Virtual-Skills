{"mode":"Text","hardwareTarget":"brain","textContent":"#region VEXcode Generated Robot Configuration\nimport math\nimport random\nfrom vexcode_vrc import *\nfrom vexcode_vrc.events import get_Task_func\n\n# Brain should be defined by default\nbrain=Brain()\n\nclaw_motor = Motor(\"ClawMotor\", 6)\narm_motor = Motor(\"ArmMotor\", 8)\ndistance = Distance(\"Distance\", 10)\nai_vision = AiVision(\"aiVision\", 7)\ngps = GPS(\"GPS\", 4)\ndrivetrain = Drivetrain(\"drivetrain\", 0)\n\n# 'Enum' class for AI Vision GameElements\nclass GameElements:\n    RED_BLUE_PIN = 0\n    BLUE_YELLOW_PIN = 1\n    RED_YELLOW_PIN = 2\n    YELLOW_PIN = 3\n    CUP = 4\n\n#endregion VEXcode Generated Robot Configuration\n# ------------------------------------------\n# \n# \tProject:      VEXcode Project\n#\tAuthor:       VEX\n#\tCreated:\n#\tDescription:  VEXcode VR Python Project\n# \n# ------------------------------------------\n\n# Add project code in \"main\"\nimport math\n\ndef main():\n    drivetrain.turn_for(LEFT, 45, DEGREES) #Turn to toggle\n    drivetrain.drive_for(REVERSE, 50, MM) #Drive back to the toggle\n    arm_motor.spin_for(FORWARD, 540, DEGREES) #Lift up arm\n    arm_motor.spin_for(REVERSE, 360, DEGREES) #Move arm down for toggle, aprox 180 degrees for each turn on the toggle?\n    drivetrain.drive_for(FORWARD, 50, MM) #Drive back to position\n    drivetrain.turn_for(RIGHT, 45, DEGREES) #Turn towards goal\n    drivetrain.drive_for(FORWARD, 275, MM) #Move to goal\n    claw_motor.spin_for(REVERSE, 360, DEGREES) #Release pin\n    drivetrain.drive_for(REVERSE, 100, MM) #Reverse to reposition\n    drivetrain.turn_to_rotation(95, DEGREES) #Turn towards yellow pin/cup\n    drivetrain.drive_for(FORWARD, 200, MM) #Drive towards yellow pin\n    arm_motor.spin_for(REVERSE, 360, DEGREES) #Lower arm \n    claw_motor.spin_for(FORWARD, 360, DEGREES) #Close claw to grab pin\n    drivetrain.drive_for(REVERSE, 200, MM) #Drive backwards\n    drivetrain.turn_to_rotation(0, DEGREES) #Turn towards goal, 0 refers to starting position (45*)\n    arm_motor.spin_for(FORWARD, 360, DEGREES) #Raise arm\n    drivetrain.drive_for(FORWARD, 100, MM) #Drive closer to goal\n    claw_motor.spin_for(REVERSE, 360, DEGREES) #Drop pin\n\n# VR threads TEST — Do not delete\nvr_thread(main)\n","textLanguage":"python","robotConfig":[],"slot":0,"platform":"PG","sdkVersion":"20240802.15.00.00","appVersion":"4.68.1","minVersion":"4.60.0","fileFormat":"2.0.0","targetBrainGen":"First","v5SoundsEnabled":false,"aiVisionSettings":{"colors":[],"codes":[],"tags":true,"AIObjects":true,"AIObjectModel":[],"aiModelDropDownValue":null},"playground":"V5RC27","robotModel":"v5rc27","playgroundConfig":{"playground_id":"VRC_2026-2027","activity_id":"0","robot_starting_location":"C","robot_starting_orientation":0,"playground_specific_data":{"Preload":{"preload_pin_orientation_flipped":false}},"navigation_kit_data":{"settings":{"robot_position_offset_index":0,"hide_labels_in_playmode":false},"waypoints":[]}}}