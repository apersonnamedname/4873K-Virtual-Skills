{"mode":"Text","hardwareTarget":"brain","textContent":"#region VEXcode Generated Robot Configuration\nimport math\nimport random\nfrom vexcode_vrc import *\nfrom vexcode_vrc.events import get_Task_func\n\n# Brain should be defined by default\nbrain=Brain()\n\nclaw_motor = Motor(\"ClawMotor\", 6)\narm_motor = Motor(\"ArmMotor\", 8)\ndistance = Distance(\"Distance\", 10)\nai_vision = AiVision(\"aiVision\", 7)\ngps = GPS(\"GPS\", 4)\ndrivetrain = Drivetrain(\"drivetrain\", 0)\n\n# 'Enum' class for AI Vision GameElements\nclass GameElements:\n    RED_BLUE_PIN = 0\n    BLUE_YELLOW_PIN = 1\n    RED_YELLOW_PIN = 2\n    YELLOW_PIN = 3\n    CUP = 4\n\n#endregion VEXcode Generated Robot Configuration\n# ------------------------------------------\n# \n# \tProject:      VEXcode Project\n#\tAuthor:       VEX\n#\tCreated:\n#\tDescription:  VEXcode VR Python Project\n# \n# ------------------------------------------\n\n# Add project code in \"main\"\nimport math\n\ndef main():\n    #If we want the number one worldwide score, we need to score 24 pins and go to middle\n    #Optomizations needed: Raising and lowering arm while moving instead of stopping. Reason why it's stopping is cause i've been measuring the degree of turns\n    #Custom made functions needed for readbility, i've been brute forcing this\n    #Pathing that needs less turns and adjustments\n    #turn_to_rotation is probably better than turn_for\n    #I just realized the defualt velocity is 50%, we can speed this up?\n\n    #100 percent velocity makes this bot and pathing very violent, adjust pathing for efficency \n    # drivetrain.set_drive_velocity(75, PERCENT)\n    # arm_motor.set_velocity(100, PERCENT)\n    # claw_motor.set_velocity(100, PERCENT)\n\n    #Toggle\n    drivetrain.turn_for(LEFT, 45, DEGREES) #Turn to toggle\n    drivetrain.drive_for(REVERSE, 50, MM) #Drive back to the toggle\n    arm_motor.spin_for(FORWARD, 540, DEGREES) #Lift up arm\n    arm_motor.spin_for(REVERSE, 360, DEGREES) #Move arm down for toggle, aprox 180 degrees for each turn on the toggle?\n\n    #Pin 1 (preload)\n    drivetrain.drive_for(FORWARD, 50, MM) #Drive back to position\n    drivetrain.turn_for(RIGHT, 45, DEGREES) #Turn towards goal\n    drivetrain.drive_for(FORWARD, 275, MM) #Move to goal\n    claw_motor.spin_for(REVERSE, 360, DEGREES) #Release pin\n\n    #Pin 2 (yellow next to wall)\n    drivetrain.drive_for(REVERSE, 100, MM) #Reverse to reposition\n    drivetrain.turn_to_rotation(95, DEGREES) #Turn towards yellow pin/cup\n    drivetrain.drive_for(FORWARD, 180, MM) #Drive towards yellow pin\n    arm_motor.spin_for(REVERSE, 360, DEGREES) #Lower arm \n    claw_motor.spin_for(FORWARD, 360, DEGREES) #Close claw to grab pin, lowkey a 50/50 based on physics\n    drivetrain.drive_for(REVERSE, 200, MM) #Drive backwards\n    drivetrain.turn_to_rotation(0, DEGREES) #Turn towards goal, 0 refers to starting position (45*)\n    arm_motor.spin_for(FORWARD, 360, DEGREES) #Raise arm\n    drivetrain.drive_for(FORWARD, 100, MM) #Drive closer to goal\n    claw_motor.spin_for(REVERSE, 360, DEGREES) #Drop pin\n    \n    #Pin 3\n    drivetrain.drive_for(REVERSE, 100, MM) #commenting is hard and sleep is even harder\n    drivetrain.turn_for(RIGHT, 45, DEGREES)\n    drivetrain.drive_for(FORWARD, 875, MM)\n    drivetrain.turn_for(LEFT, 90, DEGREES)\n    arm_motor.spin_for(REVERSE, 360, DEGREES)\n    claw_motor.spin_for(FORWARD, 360, DEGREES)\n    drivetrain.turn_for(LEFT, 90, DEGREES)\n    arm_motor.spin_for(FORWARD, 1080, DEGREES)\n    drivetrain.drive_for(FORWARD, 600, MM)\n    drivetrain.turn_for(RIGHT, 90, DEGREES)\n    claw_motor.spin_for(REVERSE, 360, DEGREES)\n\n    #Pin 4\n    drivetrain.turn_for(RIGHT, 90, DEGREES)\n    arm_motor.spin_for(REVERSE, 1080, DEGREES)\n    drivetrain.drive_for(FORWARD, 875, MM)\n    drivetrain.turn_for(RIGHT, 90, DEGREES)\n    drivetrain.drive_for(FORWARD, 50, MM)\n    claw_motor.spin_for(FORWARD, 360, DEGREES)\n    drivetrain.drive_for(REVERSE, 350, MM)\n    drivetrain.turn_for(RIGHT, 90, DEGREES)\n    arm_motor.spin_for(FORWARD, 1600, DEGREES)\n    drivetrain.drive_for(FORWARD, 650, MM)\n    claw_motor.spin_for(REVERSE, 360, DEGREES)\n\n    #Pin 5 and to center\n    drivetrain.drive_for(REVERSE, 625, MM)\n    drivetrain.turn_for(LEFT, 90, DEGREES)\n    arm_motor.spin_for(REVERSE, 1600, DEGREES)\n    drivetrain.drive_for(FORWARD, 350, MM)\n    claw_motor.spin_for(FORWARD, 360, DEGREES)\n    drivetrain.drive_for(REVERSE, 70, MM)\n    drivetrain.turn_to_rotation(270, DEGREES)\n    arm_motor.spin_for(FORWARD, 540, DEGREES)\n    drivetrain.drive_for(FORWARD, 1825, MM)\n    # drivetrain.turn_to_rotation(315, DEGREES)\n    claw_motor.spin_for(REVERSE, 360, DEGREES)\n\n\n    #Temp code for 8 points\n    # drivetrain.turn_for(RIGHT, 60, DEGREES)\n    # drivetrain.drive(FORWARD)\n\n# VR threads TEST — Do not delete\nvr_thread(main)\n","textLanguage":"python","robotConfig":[],"slot":0,"platform":"PG","sdkVersion":"20240802.15.00.00","appVersion":"4.68.1","minVersion":"4.60.0","fileFormat":"2.0.0","targetBrainGen":"First","v5SoundsEnabled":false,"aiVisionSettings":{"colors":[],"codes":[],"tags":true,"AIObjects":true,"AIObjectModel":[],"aiModelDropDownValue":null},"playground":"V5RC27","robotModel":"v5rc27","playgroundConfig":{"playground_id":"VRC_2026-2027","activity_id":"0","robot_starting_location":"C","robot_starting_orientation":0,"playground_specific_data":{"Preload":{"preload_pin_orientation_flipped":false}},"navigation_kit_data":{"settings":{"robot_position_offset_index":0,"hide_labels_in_playmode":false},"waypoints":[]}}}